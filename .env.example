# --- Copy this file to `.env` and fill in the real keys. Never commit `.env`. ---

# Capital One Nessie (FinTech track). Get a key at http://api.nessieisreal.com
# If this is blank the server silently falls back to in-memory demo data
# and the UI shows an "OFFLINE: demo data" badge instead of crashing.
NESSIE_API_KEY=

# Optional: pin a specific Nessie account id. You do NOT need this -- the server
# creates its own customer, account, merchants and purchase history on first run.
# Set this only to point at a specific account you made in the Nessie console.
NESSIE_ACCOUNT_ID=

# Google AI Studio key for Gemini (writes the commentary script).
# If blank, the server falls back to canned lines from server/canned.ts.
GEMINI_API_KEY=

# ElevenLabs key. Only needed for the broadcast to have real AI voices.
# If blank or out of credits, the client falls back to browser speechSynthesis.
ELEVENLABS_API_KEY=

# Play-by-play voice ID (energetic male). Pick one at
# https://elevenlabs.io/app/voices and paste the ID here.
# Mike = "David", a booming stadium PA announcer.
ELEVENLABS_VOICE_PBP=DduhIyyKkOosbP8VefhP

# Color commentator voice ID (sharp female / dry delivery).
# Linda = "Rachel", warm conversational Australian.
ELEVENLABS_VOICE_COLOR=U9VgC8Xinl7nnNsyDd3J

# --- Optional overrides (sensible defaults are built in) ---

# --- MODEL TIER: cheap while you build, big on demo day ---------------------
# Dev stays on the *-flash-lite tier — far cheaper, and more than fast enough
# for the booth's short JSON scripts. Swap to the big model right before you
# present. The server falls back through `MODEL_FALLBACKS` (see server/gemini.ts)
# in whichever direction that points: cheap -> pricier while you develop, and
# big -> cheaper if the headline model is saturated mid-pitch.

# Development (cheap):
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo day — uncomment this line and comment out the one above:
# GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs TTS model. Flash is already the cheapest tier, so this is what you
# want for development. `eleven_v3` / `eleven_multilingual_v2` are the expensive
# ones — only move here once the voices are picked and the script is locked.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Port for the Express server (Vite proxies /api here in dev).
PORT=8787
