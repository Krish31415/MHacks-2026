# --- Copy this file to `.env` and fill in the real keys. Never commit `.env`. ---

# Capital One Nessie (FinTech track). Get a key at http://api.nessieisreal.com
# If this is blank the server silently falls back to in-memory demo data
# and the UI shows an "OFFLINE: demo data" badge instead of crashing.
NESSIE_API_KEY=

# Google AI Studio key for Gemini (writes the commentary script).
# If blank, the server falls back to canned lines from server/canned.ts.
GEMINI_API_KEY=

# ElevenLabs key. Only needed for the broadcast to have real AI voices.
# If blank or out of credits, the client falls back to browser speechSynthesis.
ELEVENLABS_API_KEY=

# Play-by-play voice ID (energetic male). Pick one at
# https://elevenlabs.io/app/voices and paste the ID here.
ELEVENLABS_VOICE_PBP=

# Color commentator voice ID (sharp female / dry delivery).
ELEVENLABS_VOICE_COLOR=

# --- Optional overrides (sensible defaults are built in) ---

# Low-latency TTS model. Docs-verified current flash tier.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Gemini model used for commentary. Current stable flash tier.
GEMINI_MODEL=gemini-3.8-flash

# Port for the Express server (Vite proxies /api here in dev).
PORT=8787
